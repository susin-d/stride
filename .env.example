# ─────────────────────────────────────────────
# STRIDE — Environment Configuration
# Copy this file to .env and fill in secrets.
# ─────────────────────────────────────────────

# ── Database ────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Or full Supabase URL:
# DATABASE_URL_OVERRIDE=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── JWT ─────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ─────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Seed Data ───────────────────────────────
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@stride.app
DEMO_USER_PASSWORD=password123
DEMO_USER_NAME=Susindran

# ── Frontend ────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
